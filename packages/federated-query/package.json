{
  "name": "federated-query",
  "version": "0.1.0",
  "type": "module",
  "description": "Drop-in replacement for RTK Query with transparent Micro-Frontend (MFE) support",
  "keywords": ["rtk-query", "redux", "micro-frontend", "mfe", "module-federation", "cache", "invalidation"],
  "license": "MIT",
  "author": "Esan Mohammad",
  "repository": {
    "type": "git",
    "url": "https://github.com/esanmohammad/federated-query"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.0"
  },
  "devDependencies": {
    "@repo/tsconfig": "*",
    "@reduxjs/toolkit": "^2.2.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "14.3.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "25.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "2.1.9"
  }
}
